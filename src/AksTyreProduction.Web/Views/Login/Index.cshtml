@{Layout=null;ViewData["Title"]="Staff sign in";}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Staff Sign In | AKS Tyre Services</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        *{box-sizing:border-box}
        :root{--ink:#142d38;--muted:#637780;--line:#dbe4e7;--sea:#167d9d;--sea-dark:#10566c;--orange:#e6a43b;--paper:#f4f7f8}
        body{min-height:100vh;margin:0;background:var(--paper);color:var(--ink);font-family:"Segoe UI",Arial,sans-serif}
        .page-shell{min-height:100vh;display:flex;flex-direction:column;background:linear-gradient(125deg,#f8fafb 0%,#eef4f5 54%,#e8f0f2 100%)}
        .site-head{height:104px;display:flex;align-items:center;justify-content:space-between;padding:10px clamp(22px,6vw,92px);background:rgba(255,255,255,.94);border-bottom:1px solid var(--line)}
        .brand-logo{display:block;width:230px;max-width:54vw;height:auto}
        .service-link{display:flex;align-items:center;gap:12px;color:var(--ink);text-decoration:none;font-size:14px;font-weight:700}
        .service-link:hover{color:var(--sea-dark)}
        .service-dot{width:10px;height:10px;border-radius:50%;background:#16875c;box-shadow:0 0 0 5px #e2f2e9}
        .main-grid{width:min(900px,100%);flex:1;margin:0 auto;padding:46px clamp(22px,6vw,92px);display:grid;grid-template-columns:minmax(0,440px);justify-content:center;align-items:center}
        .signin-panel{width:100%;max-width:440px;justify-self:center;padding:34px 0}
        .signin-panel .eyebrow{margin-bottom:10px}
        .signin-panel h2{margin:0;font-size:32px;font-weight:700;letter-spacing:0}
        .signin-panel .intro{margin:9px 0 25px;color:var(--muted);font-size:15px;line-height:1.5}
        .signin-panel label{display:block;margin:0 0 7px;font-size:13px;font-weight:700;color:#253f49}
        .signin-panel input:not([type=hidden]){display:block;width:100%;height:48px;margin:0 0 18px;padding:0 13px;border:1px solid #c9d6db;border-radius:4px;background:#fff;color:var(--ink);font-size:16px}
        .signin-panel input:focus{outline:3px solid #d8edf2;border-color:var(--sea)}
        .signin-panel button{display:flex;width:100%;min-height:50px;align-items:center;justify-content:space-between;padding:0 17px;border:0;border-radius:4px;background:var(--sea-dark);color:#fff;font-weight:750;cursor:pointer;transition:background .18s ease}
        .signin-panel button:hover{background:#0b4659}
        .button-arrow{font-size:19px;font-weight:400}
        .alert{margin:0 0 18px;padding:12px 14px;border:1px solid #e6bfc2;border-radius:4px;background:#fff3f3;color:#8c2831}
        .site-foot{display:flex;justify-content:space-between;gap:20px;padding:18px clamp(22px,6vw,92px);border-top:1px solid var(--line);color:#6c7e85;font-size:12px}
        @@media(max-width:820px){.site-head{height:88px}.main-grid{padding-top:32px;padding-bottom:32px}.signin-panel{max-width:none;padding:20px 0}.site-foot{flex-direction:column;gap:6px}}
        @@media(max-width:460px){.site-head{padding:8px 18px}.brand-logo{width:190px}.service-link{font-size:12px;gap:9px}.main-grid{padding-left:25px;padding-right:25px}.signin-panel h2{font-size:28px}}
    </style>
</head>
<body>
    <div class="page-shell">
        <header class="site-head">
            <img class="brand-logo" src="~/images/aks-tyre-services.svg" asp-append-version="true" alt="AKS Tyre Services CC" />
            <div class="service-link" aria-label="24/7 tyre breakdown service">
                <span class="service-dot" aria-hidden="true"></span>
                <span>24/7 Breakdown Service</span>
            </div>
        </header>

        <main class="main-grid">
            <section class="signin-panel" aria-labelledby="signin-heading">
                <p class="eyebrow">TEAM ACCESS</p>
                <h2 id="signin-heading">Staff sign in</h2>
                <p class="intro">Sign in with your assigned account to continue.</p>
                @if(ViewBag.Error!=null){<div class="alert" role="alert">@ViewBag.Error</div>}
                <form method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <label for="username">Username</label>
                    <input id="username" name="username" autocomplete="username" autofocus required />
                    <label for="password">Password</label>
                    <input id="password" name="password" type="password" autocomplete="current-password" required />
                    <button type="submit"><span>Sign in</span><span class="button-arrow" aria-hidden="true">→</span></button>
                </form>
            </section>
        </main>

    </div>
</body>
</html>