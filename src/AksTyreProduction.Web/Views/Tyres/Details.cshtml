@model Tyre
@inject AksTyreProduction.Web.Data.AppDbContext Db
@{
    ViewData["Title"] = $"Passport {Model.AksTyreId}";
    var current = TyreHistory.SelectRetread(Model, null) ?? Model.RetreadJobs.OrderByDescending(x => x.RetreadNumber).First();
    var selectedRetreadId = ViewBag.SelectedRetreadId is int selectedId && selectedId > 0 ? selectedId : current.Id;
    var selected = TyreHistory.SelectRetread(Model, selectedRetreadId) ?? current;
    var isWorker = User.IsInRole(ApplicationRoles.Worker);
    var canWriteJobs = !isWorker || User.HasClaim(ApplicationPolicies.PermissionClaimType, ApplicationPolicies.JobsWriteClaim);
    var materials = canWriteJobs ? Db.Materials.Include(x => x.Batches).Where(x => x.Active).ToList() : [];
    string R(decimal v) => v.ToString("C2", CultureInfo.GetCultureInfo("en-ZA"));
}

<div class="passport-head">
    <div class="d-flex justify-content-between flex-wrap gap-3 align-items-center">
        <div>
            <div class="eyebrow light">DIGITAL TYRE PASSPORT</div>
            <h1>@Model.AksTyreId</h1>
            <div class="passport-subtitle">@Model.Brand @Model.Size · Serial: @Model.SerialNumber</div>
            <a class="btn btn-warning mt-3" asp-action="Tag" asp-route-id="@Model.Id" target="_blank">Barcode Tag / Print</a>
        </div>
        <div class="text-end">
            <span class="status-pill @(current.Status == JobStatus.Rejected ? "status-danger" : "status-active")">@current.Status</span>
            <div class="mt-2 passport-meta">Retread #@current.RetreadNumber · @current.CurrentStage</div>
            @if (current.EstimatedCompletion.HasValue)
            {
                <small>Estimated completion @current.EstimatedCompletion.Value.ToString("dd MMM yyyy HH:mm")</small>
            }
        </div>
    </div>
</div>

<div class="grid-3 mb-4">
    <div class="card lift-panel">
        <div class="card-header">Tyre Details</div>
        <div class="card-body detail-list">
            <small class="muted">BRAND & SIZE</small>
            <p>@Model.Brand @Model.Size</p>
            <small class="muted">TREAD / APPLICATION</small>
            <p>@Model.OriginalTreadPattern · @Model.Application</p>
            <small class="muted">CASING</small>
            <p class="mb-0">@Model.CasingCondition</p>
        </div>
    </div>

    <div class="card lift-panel">
        <div class="card-header">Customer Details</div>
        <div class="card-body detail-list">
            <strong>@Model.Customer.Name</strong>
            <p>@Model.Customer.AccountNumber<br />@Model.Customer.Site<br />@Model.Customer.Address</p>
        </div>
    </div>

    <div class="card lift-panel">
        <div class="card-header">Current Retread</div>
        <div class="card-body detail-list">
            <strong>@current.JobNumber</strong>
            <p>Received @current.ReceivedAt.ToString("dd MMM yyyy HH:mm")</p>
            @if (current.QcPassedAt.HasValue)
            {
                <p>QC passed by @current.QcOperatorNameSnapshot at @current.QcPassedAt.Value.ToString("dd MMM yyyy HH:mm")</p>
            }
            <div class="station-steps">
                @foreach (var stage in Workflow.Stages)
                {
                    var done = current.StationTransactions.Any(x => x.Station == stage && x.EndedAt != null);
                    <span class="station-step @(done ? "done" : stage == current.CurrentStage ? "current" : "")">@stage</span>
                }
            </div>
            <a class="btn btn-sm btn-primary mt-3" asp-controller="Stations" asp-action="Index" asp-route-station="@current.CurrentStage" asp-route-tyreCode="@Model.AksTyreId">Open Factory Station</a>
            @if (!isWorker)
            {
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a class="btn btn-sm btn-outline-primary" asp-controller="Forms" asp-action="Preview" asp-route-id="retread-inspection" asp-route-tyreId="@Model.Id" asp-route-retreadId="@current.Id">Retread Inspection</a>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Forms" asp-action="Preview" asp-route-id="job-card" asp-route-tyreId="@Model.Id" asp-route-retreadId="@current.Id">Job Card</a>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Forms" asp-action="Preview" asp-route-id="tyre-action" asp-route-tyreId="@Model.Id" asp-route-retreadId="@current.Id">Tyre Action</a>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Forms" asp-action="Preview" asp-route-id="vehicle-survey" asp-route-tyreId="@Model.Id" asp-route-retreadId="@current.Id">Vehicle Survey</a>
            </div>
            }
        </div>
    </div>
</div>

<div class="grid-2 mb-4">
    <section class="card lift-panel">
        <div class="card-header">Production Timeline · Retread #@current.RetreadNumber</div>
        <div class="card-body">
            <div class="timeline">
                @foreach (var tx in current.StationTransactions.OrderByDescending(x => x.StartedAt))
                {
                    var details = JsonSerializer.Deserialize<Dictionary<string, string>>(tx.DetailsJson ?? "{}") ?? new Dictionary<string, string>();
                    <div class="timeline-item @(tx.Result == TransactionResult.Fail ? "failed" : "")">
                        <div class="d-flex justify-content-between">
                            <strong>@tx.Station · @tx.Result</strong>
                            <small>@tx.StartedAt.ToString("dd MMM HH:mm") @if (tx.EndedAt.HasValue) { <span>to @tx.EndedAt.Value.ToString("dd MMM HH:mm")</span> }</small>
                        </div>
                        <div class="muted">@tx.Operator.Name · @tx.DurationMinutes min @if (!isWorker) { <span>· Labour @R(tx.LabourCost)</span> }</div>
                        <div>@tx.Notes @tx.FailureReason</div>
                        @if (details.Any())
                        {
                            <div class="small mt-1">
                                @foreach (var d in details.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
                                {
                                    <span class="badge text-bg-light me-1">@d.Key: @d.Value</span>
                                }
                            </div>
                        }
                    </div>
                }
                @if (!current.StationTransactions.Any())
                {
                    <p class="mb-0">No production events yet.</p>
                }
            </div>
        </div>
    </section>

    @if (!isWorker)
    {
    <section class="card lift-panel">
        <div class="card-header">Actual Cost & Invoice</div>
        <div class="card-body detail-list">
            <div class="d-flex justify-content-between"><span>Base cost</span><span>@R(current.BaseCost)</span></div>
            @foreach (var group in current.MaterialUsages.GroupBy(x => x.Material.Name))
            {
                <div class="d-flex justify-content-between"><span>@group.Key</span><span>@R(group.Sum(x => x.TotalCost))</span></div>
            }
            <div class="d-flex justify-content-between"><span>Labour</span><span>@R(current.LabourCost)</span></div>
            <hr />
            <div class="d-flex justify-content-between fs-5"><strong>Production Cost</strong><strong>@R(current.TotalCost)</strong></div>
            <div class="d-flex justify-content-between"><span>Markup (@current.MarkupPercent%)</span><strong>@R(current.SellingPrice - current.TotalCost)</strong></div>
            <div class="d-flex justify-content-between text-primary fs-5"><strong>Selling Price</strong><strong>@R(current.SellingPrice)</strong></div>
            @if (current.Invoice != null)
            {
                <div class="alert alert-success mt-3 mb-0">Draft invoice <strong>@current.Invoice.InvoiceNumber</strong> · @R(current.Invoice.SellingPriceSnapshot)</div>
            }
            else if (current.Status is JobStatus.QcPassed or JobStatus.ReadyForDispatch or JobStatus.Dispatched)
            {
                <form asp-controller="Invoices" asp-action="Create" method="post" class="mt-3">
                    <input type="hidden" name="jobId" value="@current.Id" />
                    <input type="hidden" name="tyreId" value="@Model.Id" />
                    <div class="input-group">
                        <input class="form-control" name="invoiceNumber" required placeholder="INV-26001" />
                        <button class="btn btn-outline-primary">Create Draft Invoice</button>
                    </div>
                </form>
            }
        </div>
    </section>
    }
</div>

<div class="grid-2 mb-4">
    <section class="card lift-panel">
        <div class="card-header">Materials & Batch Traceability</div>
        <div class="card-body">
            <table class="table table-sm">
                <thead>
                    <tr><th>Material</th><th>Batch</th><th>Qty</th>@if (!isWorker) { <th>Captured Cost</th> }</tr>
                </thead>
                <tbody>
                    @foreach (var u in current.MaterialUsages)
                    {
                        <tr>
                            <td>@u.Material.Name</td>
                            <td>@(u.MaterialBatch?.LotNumber ?? "—")</td>
                            <td>@u.Quantity @u.Material.UnitOfMeasure</td>
                            @if (!isWorker) { <td>@R(u.TotalCost)</td> }
                        </tr>
                    }
                </tbody>
            </table>

            @if (canWriteJobs)
            {
            <form asp-controller="Materials" asp-action="Use" method="post" class="row g-2 mt-3">
                <input type="hidden" name="jobId" value="@current.Id" />
                <input type="hidden" name="tyreId" value="@Model.Id" />
                <div class="col-5">
                    <select class="form-select" name="materialId">
                        <option value="">Material...</option>
                        @foreach (var m in materials)
                        {
                            <option value="@m.Id">@m.Name @if (!isWorker) { <span>· @R(m.CurrentUnitCost)/@m.UnitOfMeasure</span> }</option>
                        }
                    </select>
                </div>
                <div class="col-3">
                    <input class="form-control" type="number" step="0.01" name="quantity" placeholder="Quantity" />
                </div>
                <div class="col-4">
                    <select class="form-select" name="batchId">
                        <option value="">No batch</option>
                        @foreach (var b in materials.SelectMany(x => x.Batches))
                        {
                            <option value="@b.Id">@b.LotNumber (@b.Material.Name)</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <button class="btn btn-outline-primary w-100">Add Actual Material Usage</button>
                </div>
            </form>
            }
        </div>
    </section>

    <section class="card lift-panel">
        <div class="card-header">Photos / Attachments</div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 photo-grid">
                @foreach (var p in Model.RetreadJobs.SelectMany(x => x.Photos))
                {
                    <a href="~/uploads/@p.FileName" target="_blank"><img src="~/uploads/@p.FileName" /></a>
                }
            </div>
            @if (canWriteJobs)
            {
            <form asp-action="Upload" method="post" enctype="multipart/form-data" class="mt-3">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="jobId" value="@current.Id" />
                <label class="form-label">Associate with production event</label>
                <select name="stationTransactionId" class="form-select mb-2">
                    <option value="">General tyre photo</option>
                    @foreach (var tx in current.StationTransactions.OrderByDescending(x => x.StartedAt))
                    {
                        <option value="@tx.Id">@tx.Station · @tx.StartedAt.ToString("dd MMM HH:mm") · @tx.Result</option>
                    }
                </select>
                <label class="form-label">Inspection, defect, repair or production photo</label>
                <input class="form-control mb-2" type="file" accept="image/*" name="photo" />
                <button class="btn btn-outline-secondary">Upload Photo</button>
            </form>
            }
        </div>
    </section>
</div>

<section class="card lift-panel mb-4">
    <div class="card-header">Repairs Performed</div>
    <div class="card-body">
        <table class="table table-sm">
            <thead>
                <tr><th>Type</th><th>Location</th><th>Patch</th><th>Qty</th><th>Description</th></tr>
            </thead>
            <tbody>
                @foreach (var repair in current.Repairs)
                {
                    <tr>
                        <td>@repair.Type</td>
                        <td>@repair.Location</td>
                        <td>@repair.PatchSize</td>
                        <td>@repair.Quantity</td>
                        <td>@repair.Description</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (canWriteJobs)
        {
        <form asp-action="AddRepair" method="post" class="row g-2 mt-3">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="jobId" value="@current.Id" />
            <div class="col-md-2"><input class="form-control" name="type" required placeholder="Repair type" /></div>
            <div class="col-md-2"><input class="form-control" name="location" placeholder="Location" /></div>
            <div class="col-md-2"><input class="form-control" name="patchSize" placeholder="Patch size" /></div>
            <div class="col-md-2"><input class="form-control" name="quantity" type="number" min="1" value="1" /></div>
            <div class="col-md-3"><input class="form-control" name="description" placeholder="Description" /></div>
            <div class="col-md-1"><button class="btn btn-outline-primary">Add</button></div>
        </form>
        }
    </div>
</section>

<section class="card lift-panel mb-4">
    <div class="card-header">Selected Retread Detail</div>
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <strong>@selected.JobNumber</strong>
                <div class="muted">Retread #@selected.RetreadNumber · Received @selected.ReceivedAt.ToString("dd MMM yyyy HH:mm")</div>
            </div>
            <div class="text-end">
                <span class="status-pill @(selected.Status == JobStatus.Rejected ? "status-danger" : "status-active")">@selected.Status</span>
                @if (selected.Id != current.Id)
                {
                    <div class="mt-2"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Return to current retread</a></div>
                }
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-7">
                <h6>Timeline</h6>
                <div class="timeline">
                    @foreach (var tx in selected.StationTransactions.OrderByDescending(x => x.StartedAt))
                    {
                        var details = JsonSerializer.Deserialize<Dictionary<string, string>>(tx.DetailsJson ?? "{}") ?? new Dictionary<string, string>();
                        <div class="timeline-item @(tx.Result == TransactionResult.Fail ? "failed" : "")">
                            <div class="d-flex justify-content-between">
                                <strong>@tx.Station · @tx.Result</strong>
                                <small>@tx.StartedAt.ToString("dd MMM HH:mm") @if (tx.EndedAt.HasValue) { <span>to @tx.EndedAt.Value.ToString("dd MMM HH:mm")</span> }</small>
                            </div>
                            <div class="muted">@tx.Operator.Name · @tx.DurationMinutes min @if (!isWorker) { <span>· Labour @R(tx.LabourCost)</span> }</div>
                            <div>@tx.Notes @tx.FailureReason</div>
                            @if (details.Any())
                            {
                                <div class="small mt-1">
                                    @foreach (var d in details.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
                                    {
                                        <span class="badge text-bg-light me-1">@d.Key: @d.Value</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (!selected.StationTransactions.Any())
                    {
                        <p class="mb-0">No production events recorded for this retread.</p>
                    }
                </div>
            </div>
            @if (!isWorker)
            {
            <div class="col-lg-5">
                <h6>Cost breakdown</h6>
                <div class="detail-list">
                    <div class="d-flex justify-content-between"><span>Base cost</span><span>@R(selected.BaseCost)</span></div>
                    @foreach (var group in selected.MaterialUsages.GroupBy(x => x.Material.Name))
                    {
                        <div class="d-flex justify-content-between"><span>@group.Key</span><span>@R(group.Sum(x => x.TotalCost))</span></div>
                    }
                    <div class="d-flex justify-content-between"><span>Labour</span><span>@R(selected.LabourCost)</span></div>
                    <hr />
                    <div class="d-flex justify-content-between fs-5"><strong>Total cost</strong><strong>@R(selected.TotalCost)</strong></div>
                </div>

                <h6 class="mt-4">Repairs</h6>
                @if (selected.Repairs.Any())
                {
                    <ul class="list-unstyled small mb-0">
                        @foreach (var repair in selected.Repairs)
                        {
                            <li class="mb-2"><strong>@repair.Type</strong> · @repair.Location · @repair.PatchSize<br /><span class="muted">@repair.Description</span></li>
                        }
                    </ul>
                }
                else
                {
                    <p class="muted mb-0">No repairs recorded.</p>
                }
            </div>
            }
        </div>
    </div>
</section>

<section class="card lift-panel mb-4">
    <div class="card-header">Lifetime Retread History</div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr><th>Retread</th><th>Job</th><th>Received</th><th>Completed</th><th>Result</th><th>Events</th><th>Repairs</th>@if (!isWorker) { <th>Cost</th> }<th></th></tr>
            </thead>
            <tbody>
                @foreach (var job in Model.RetreadJobs.OrderByDescending(x => x.RetreadNumber))
                {
                    <tr class="@(job.Id == selected.Id ? "table-active" : "")">
                        <td class="fw-bold">#@job.RetreadNumber</td>
                        <td>@job.JobNumber</td>
                        <td>@job.ReceivedAt.ToString("dd MMM yyyy")</td>
                        <td>@(job.CompletedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td>@job.Status</td>
                        <td>@job.StationTransactions.Count</td>
                        <td>@job.Repairs.Count</td>
                        @if (!isWorker) { <td class="money">@R(job.TotalCost)</td> }
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@Model.Id" asp-route-retreadId="@job.Id">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="d-flex gap-2 flex-wrap">
    @if (!isWorker && (current.Status is JobStatus.Dispatched or JobStatus.Rejected) && !Model.IsScrapped)
    {
        <form asp-action="NewRetread" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <input class="form-control d-inline-block" style="width:180px" name="jobNumber" required placeholder="New job number" />
            <button class="btn btn-primary">Start New Retread</button>
        </form>
    }
    @if (!isWorker && !Model.IsScrapped)
    {
        <form asp-action="Scrap" method="post" onsubmit="return confirm('Permanently scrap this tyre?')">
            <input type="hidden" name="id" value="@Model.Id" />
            <input class="form-control d-inline-block" style="width:240px" name="reason" required placeholder="Scrap reason" />
            <button class="btn btn-outline-danger">Scrap Tyre</button>
        </form>
    }
    else
    {
        <div class="alert alert-danger">Permanently scrapped: @Model.ScrapReason</div>
    }
</div>
