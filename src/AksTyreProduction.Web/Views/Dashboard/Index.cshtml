@model DashboardVm
@{
    ViewData["Title"] = "Management Dashboard";
    string R(decimal v) => v.ToString("C2", CultureInfo.GetCultureInfo("en-ZA"));
    var spotlight = Model.Recent.FirstOrDefault();
    var spotlightTyre = spotlight?.RetreadJob?.Tyre;
    var workflow = new[]
    {
        new { Name = "Receiving", Value = "08:10", Tone = "done" },
        new { Name = "Initial inspection", Value = "08:25", Tone = "done" },
        new { Name = "Shearography", Value = "08:45", Tone = "done" },
        new { Name = "Buffing", Value = "09:12", Tone = "active" },
        new { Name = "Repair & patching", Value = "11:00", Tone = "queued" },
        new { Name = "Curing", Value = "15:00", Tone = "queued" },
        new { Name = "QC release", Value = "Pending", Tone = "pending" },
        new { Name = "Dispatch", Value = "Ready", Tone = "pending" }
    };
}

<div class="page-head">
    <div>
        <div class="eyebrow">OPERATIONS OVERVIEW</div>
        <h1>AKS Tyre Services CC</h1>
        <p>Live retread production snapshot · @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="status-pill status-active"><span class="dot dot-green"></span>Admin</div>
        <a class="btn btn-warning" asp-controller="Tyres" asp-action="Receive">+ Receive Tyre</a>
    </div>
</div>

<div class="kpi-grid">
    <div class="kpi">
        <small>Tyres received</small>
        <strong>@Model.ReceivedToday</strong>
        <span class="delta positive">+12%</span>
    </div>
    <div class="kpi">
        <small>In production</small>
        <strong>@Model.InProduction</strong>
        <span class="delta neutral">5 overdue</span>
    </div>
    <div class="kpi">
        <small>Completed</small>
        <strong>@Model.Completed</strong>
        <span class="delta positive">+8%</span>
    </div>
    <div class="kpi bad">
        <small>Rejected</small>
        <strong>@Model.Rejected</strong>
        <span class="delta negative">Review</span>
    </div>
    <div class="kpi warn">
        <small>Awaiting repair</small>
        <strong>@Model.AwaitingRepair</strong>
        <span class="delta neutral">Needs action</span>
    </div>
    <div class="kpi warn">
        <small>Awaiting QC</small>
        <strong>@Model.AwaitingQc</strong>
        <span class="delta neutral">Hold queue</span>
    </div>
    <div class="kpi">
        <small>Ready to dispatch</small>
        <strong>@Model.ReadyForDispatch</strong>
        <span class="delta positive">12 next shift</span>
    </div>
</div>

<div class="alert alert-info mb-4"><strong>Current bottleneck:</strong> @Model.Bottleneck</div>

<div class="grid-2 mb-4">
    <section class="card lift-panel">
        <div class="card-header">
            <div>
                <div class="eyebrow small">DIGITAL TYRE PASSPORT</div>
                <h3>@(spotlightTyre?.AksTyreId ?? "GTC260001") · Retread #@(spotlight?.RetreadJob?.RetreadNumber ?? 2)</h3>
            </div>
            <span class="status-pill status-warning">Active job</span>
        </div>
        <div class="card-body">
            <div class="passport-preview">
                <div class="passport-chip">
                    <span>Customer</span>
                    <strong>@(spotlightTyre?.Customer?.Name ?? "XYZ Logistics")</strong>
                    <small>@(spotlightTyre?.Brand ?? "Michelin") @((spotlightTyre?.Size) ?? "11R22.5")</small>
                </div>
                <div class="passport-chip accent">
                    <span>Production status</span>
                    <strong>@(spotlight?.Station ?? "Buffing")</strong>
                    <small>Estimated completion · 15:40</small>
                </div>
            </div>

            <div class="workflow-grid mt-4">
                @foreach (var step in workflow)
                {
                    var toneClass = step.Tone switch
                    {
                        "done" => "step done",
                        "active" => "step active",
                        "queued" => "step queued",
                        _ => "step pending"
                    };

                    <div class="@toneClass">
                        <div>
                            <small>@step.Name</small>
                            <strong>@step.Value</strong>
                        </div>
                        <span>@step.Tone</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <div class="stacked-panels">
        <section class="card lift-panel">
            <div class="card-header tight">
                <div class="eyebrow small">RECENT ACTIVITY</div>
            </div>
            <div class="card-body">
                @foreach (var tx in Model.Recent.Take(4))
                {
                    <div class="activity-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>@tx.RetreadJob.Tyre.AksTyreId</strong>
                            <small>@tx.StartedAt.ToString("HH:mm")</small>
                        </div>
                        <div>@tx.Station · @tx.Operator?.Name</div>
                    </div>
                }
            </div>
        </section>

        <section class="card lift-panel">
            <div class="card-header tight">
                <div class="eyebrow small">COST SNAPSHOT</div>
            </div>
            <div class="card-body compact-list">
                <div class="d-flex justify-content-between"><span>Materials</span><strong>@R(Model.MaterialCost)</strong></div>
                <div class="d-flex justify-content-between"><span>Labour</span><strong>@R(Model.LabourCost)</strong></div>
                <div class="d-flex justify-content-between"><span>Total</span><strong>@R(Model.TotalCost)</strong></div>
            </div>
        </section>
    </div>
</div>

<div class="grid-2 mb-4">
    <section class="card lift-panel">
        <div class="card-header">
            <div class="eyebrow small">CURRENT WIP BY STATION</div>
        </div>
        <div class="card-body">
            @foreach (var row in Model.Wip.OrderByDescending(x => x.Value))
            {
                <div class="bar-row">
                    <span>@row.Key</span>
                    <div class="progress-shell">
                        <div class="progress-fill" style="width:@(Math.Min(100, row.Value * 18))%"></div>
                    </div>
                    <strong>@row.Value</strong>
                </div>
            }
        </div>
    </section>

    <section class="card lift-panel">
        <div class="card-header">
            <div class="eyebrow small">STATION PERFORMANCE</div>
        </div>
        <div class="card-body compact-list">
            @foreach (var row in Model.AverageMinutes.OrderBy(x => x.Key))
            {
                <div class="d-flex justify-content-between py-2 border-bottom border-light-subtle">
                    <span>@row.Key</span>
                    <strong>@row.Value min avg</strong>
                </div>
            }
        </div>
    </section>
</div>

<div class="grid-2">
    <section class="card lift-panel">
        <div class="card-header">
            <div class="eyebrow small">OPERATOR PRODUCTIVITY</div>
        </div>
        <div class="card-body compact-list">
            @foreach (var row in Model.OperatorProductivity.OrderByDescending(x => x.Value))
            {
                <div class="d-flex justify-content-between py-2 border-bottom border-light-subtle">
                    <span>@row.Key</span>
                    <strong>@row.Value jobs</strong>
                </div>
            }
        </div>
    </section>

    <section class="card lift-panel">
        <div class="card-header">
            <div class="eyebrow small">MACHINE UTILISATION</div>
        </div>
        <div class="card-body compact-list">
            @foreach (var row in Model.MachineUtilisationMinutes.OrderByDescending(x => x.Value))
            {
                <div class="d-flex justify-content-between py-2 border-bottom border-light-subtle">
                    <span>@row.Key</span>
                    <strong>@row.Value.ToString("N0") min</strong>
                </div>
            }
        </div>
    </section>
</div>
