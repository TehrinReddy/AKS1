@model StationVm
@{ViewData["Title"]=Model.Station;var canWriteJobs=!User.IsInRole(ApplicationRoles.Worker)||User.HasClaim(ApplicationPolicies.PermissionClaimType,ApplicationPolicies.JobsWriteClaim);}
<div class="page-head"><div><h1>@Model.Station Station</h1><p>Scan tyre → verify job → capture activity → complete</p></div><span class="status-pill">Factory Mode</span></div>
<form method="get" class="scan-box mb-4"><input type="hidden" name="station" value="@Model.Station"/><label class="form-label fw-bold">SCAN / ENTER AKS TYRE ID</label><div class="input-group"><input name="tyreCode" value="@Model.TyreCode" class="form-control form-control-lg" autofocus placeholder="GTC260001"/><button class="btn btn-primary px-5">Load Job</button></div></form>
@if(Model.Job!=null)
{
<div class="grid-2"><section class="card"><div class="card-header">Loaded Production Job</div><div class="card-body"><div class="d-flex justify-content-between"><div><h3>@Model.Job.Tyre.AksTyreId</h3><p>@Model.Job.Tyre.Brand @Model.Job.Tyre.Size · @Model.Job.Tyre.Customer.Name<br/>Retread #@Model.Job.RetreadNumber · @Model.Job.JobNumber</p></div><span class="status-pill">@Model.Job.Status</span></div><div class="alert alert-light border"><strong>Expected:</strong> @Model.Job.CurrentStage<br/><strong>This station:</strong> @Model.Station</div><a asp-controller="Tyres" asp-action="Details" asp-route-id="@Model.Job.TyreId">View Digital Passport →</a></div></section>
<section class="card"><div class="card-header">Station Transaction</div><div class="card-body">
@if(Model.Station=="QC Release")
{
    @if(Model.Job.Status==JobStatus.InProduction){
        <form asp-action="ReleaseQc" method="post"><input type="hidden" name="jobId" value="@Model.Job.Id"/><input type="hidden" name="tyreCode" value="@Model.TyreCode"/><label class="form-label">QC Inspector</label><select name="operatorId" class="form-select mb-3">@foreach(var op in Model.Operators){<option value="@op.Id">@op.Name · @op.Role</option>}</select><div class="alert alert-light border mb-3">Only the latest <strong>Final Inspection</strong> marked <strong>Pass</strong> unlocks QC release.</div><button class="btn btn-success btn-lg w-100">PASS QUALITY CONTROL</button></form>
        <form asp-action="ReopenJob" method="post" class="mt-3"><input type="hidden" name="jobId" value="@Model.Job.Id"/><input type="hidden" name="tyreCode" value="@Model.TyreCode"/><input type="hidden" name="stage" value="Final Inspection"/><label class="form-label">Correct incorrect work for this job</label><select name="operatorId" class="form-select mb-3">@foreach(var op in Model.Operators){<option value="@op.Id">@op.Name · @op.Role</option>}</select><button class="btn btn-outline-warning btn-lg w-100">RE-OPEN JOB AT FINAL INSPECTION</button></form>
    }
    else if(Model.Job.Status==JobStatus.QcPassed){<div class="alert alert-success">QC passed at @Model.Job.QcPassedAt?.ToString("dd MMM HH:mm") by @Model.Job.QcOperatorNameSnapshot. Release the tyre when paperwork and invoicing are ready.</div><form asp-action="MarkReady" method="post"><input type="hidden" name="jobId" value="@Model.Job.Id"/><input type="hidden" name="tyreCode" value="@Model.TyreCode"/><button class="btn btn-primary btn-lg w-100">MARK READY FOR DISPATCH</button></form>}
    else{<div class="alert alert-success">Current status: <strong>@Model.Job.Status</strong></div>}
}
else if(Model.Station=="Dispatch")
{@if(Model.Job.Status!=JobStatus.ReadyForDispatch){<div class="alert alert-danger">Dispatch is locked. Complete Final Inspection, pass QC, and mark the tyre Ready for Dispatch first.</div>}else{<form asp-action="Dispatch" method="post"><input type="hidden" name="jobId" value="@Model.Job.Id"/><input type="hidden" name="tyreCode" value="@Model.TyreCode"/><label class="form-label">Dispatch Reference</label><input name="reference" class="form-control mb-2" required placeholder="DSP-26001"/><label class="form-label">Method</label><select name="method" class="form-select mb-2"><option>Delivery</option><option>Collection</option></select><textarea name="notes" class="form-control mb-3" placeholder="Notes"></textarea><button class="btn btn-primary btn-lg w-100">CONFIRM DISPATCH</button></form>}}
else if(Model.Active!=null&&Model.Active.Station!=Model.Station)
{<div class="alert alert-warning">An active transaction is open at <strong>@Model.Active.Station</strong>. Load that station to complete it.</div>}
else if(Model.Active==null&&Model.Job.CurrentStage!=Model.Station)
{<div class="alert alert-warning">This job must complete <strong>@Model.Job.CurrentStage</strong> next. Load that station to continue.</div>}
else if(Model.Active==null)
{@if(!canWriteJobs){<div class="alert alert-info">Read-only job access. You can view this station but cannot start or change production activity.</div>}else{<form asp-action="Start" method="post"><input type="hidden" name="jobId" value="@Model.Job.Id"/><input type="hidden" name="station" value="@Model.Station"/><input type="hidden" name="tyreCode" value="@Model.TyreCode"/><label class="form-label">Operator</label><select name="operatorId" class="form-select mb-3">@foreach(var op in Model.Operators){<option value="@op.Id">@op.Name · @op.Role · R@op.LabourRate/hr</option>}</select><label class="form-label">Machine (optional)</label><select name="machineId" class="form-select mb-4"><option value="">No machine</option>@foreach(var m in Model.Machines){<option value="@m.Id">@m.Name · @m.Status</option>}</select><button class="btn btn-warning btn-lg w-100">▶ START JOB</button></form>}}
else if(!canWriteJobs)
{<div class="alert alert-info">Read-only job access. An active transaction is open at <strong>@Model.Active.Station</strong>; you cannot complete or change it.</div>}
else
{
<div class="alert alert-warning"><strong>Active since @Model.Active.StartedAt.ToString("HH:mm")</strong><br/>@Model.Active.Station · Rate captured R@Model.Active.LabourRateSnapshot.ToString("N2")/hr</div>
<form asp-action="Complete" method="post"><input type="hidden" name="transactionId" value="@Model.Active.Id"/><input type="hidden" name="station" value="@Model.Station"/><input type="hidden" name="tyreCode" value="@Model.TyreCode"/>
@if(Model.Station == "Final Inspection")
{
    <label class="form-label">Result</label>
    <select name="result" class="form-select">
        <option value="Pass">Pass</option>
        <option value="Fail">Fail / Rework</option>
    </select>
    <div class="alert alert-warning mt-3 mb-0">Only a Final Inspection marked <strong>Pass</strong> unlocks the QC Release station.</div>
}
else
{
    <label class="form-label">Result</label>
    <select name="result" class="form-select"><option value="Completed">Complete</option><option value="Pass">Pass</option><option value="Fail">Fail / Rework</option></select>
}
@if(Model.Station is "Initial Inspection" or "Shearography / NDT" or "Final Inspection")
{<label class="form-label mt-3">Failure reason</label><select name="failureReason" class="form-select"><option value="">None / passed</option><option>Sidewall damage</option><option>Bead damage</option><option>Casing separation</option><option>Excessive wear</option><option>Run-flat damage</option><option>Belt damage</option><option>Inner liner damage</option><option>Previous repair unacceptable</option><option>Casing beyond repair</option><option>Other</option></select>}
else{<label class="form-label mt-3">Failure / defect reason</label><input name="failureReason" class="form-control" placeholder="Required for a failure"/>}
@if(Model.Station=="Shearography / NDT"){<label class="form-label mt-3">Defect location</label><input name="detail_defect_location" class="form-control"/>}
@if(Model.Station=="Buffing"){<div class="row g-2 mt-2"><div class="col-6"><label class="form-label">Buffing diameter (mm)</label><input name="detail_buffing_diameter_mm" type="number" step="0.1" class="form-control"/></div><div class="col-6"><label class="form-label">Buffing width (mm)</label><input name="detail_buffing_width_mm" type="number" step="0.1" class="form-control"/></div><div class="col-6"><label class="form-label">Buffing profile</label><input name="detail_buffing_profile" class="form-control"/></div><div class="col-6"><label class="form-label">Remaining tread (mm)</label><input name="detail_remaining_tread_mm" type="number" step="0.1" class="form-control"/></div><div class="col-6"><label class="form-label">Rubber removed (kg)</label><input name="detail_rubber_removed_kg" type="number" step="0.01" class="form-control"/></div><div class="col-6"><label class="form-label">Repair required?</label><select name="detail_repair_required" class="form-select"><option>No</option><option>Yes</option></select></div></div>}
@if(Model.Station=="Casing Repair"){<div class="row g-2 mt-2"><div class="col-6"><label class="form-label">Repair type</label><input name="detail_repair_type" class="form-control" placeholder="Sidewall / penetration"/></div><div class="col-6"><label class="form-label">Damage location</label><input name="detail_damage_location" class="form-control"/></div><div class="col-6"><label class="form-label">Patch size</label><input name="detail_patch_size" class="form-control" placeholder="100 mm"/></div><div class="col-6"><label class="form-label">Repairs completed</label><input name="detail_repair_quantity" type="number" min="1" value="1" class="form-control"/></div></div>}
@if(Model.Station=="Cushion Gum / Bonding"){<div class="alert alert-info mt-3 mb-0">Complete the station, then record each actual material quantity on the Digital Passport.</div>}
@if(Model.Station=="Tread Application"){<div class="row g-2 mt-2"><div class="col-6"><label class="form-label">Tread pattern</label><input name="detail_tread_pattern" class="form-control"/></div><div class="col-6"><label class="form-label">Manufacturer</label><input name="detail_tread_manufacturer" class="form-control"/></div><div class="col-6"><label class="form-label">Tread size</label><input name="detail_tread_size" class="form-control"/></div><div class="col-6"><label class="form-label">Length (m)</label><input name="detail_tread_length_m" type="number" step="0.01" class="form-control"/></div><div class="col-6"><label class="form-label">Weight (kg)</label><input name="detail_tread_weight_kg" type="number" step="0.01" class="form-control"/></div><div class="col-6"><label class="form-label">Batch / lot</label><input name="detail_batch_lot" class="form-control"/></div></div>}
@if(Model.Station=="Building / Enveloping"){<div class="row g-2 mt-2"><div class="col-6"><label class="form-label">Components used</label><input name="detail_components" class="form-control"/></div><div class="col-6"><label class="form-label">Envelope</label><input name="detail_envelope" class="form-control"/></div><div class="col-6"><label class="form-label">Valves</label><input name="detail_valves" class="form-control"/></div><div class="col-6"><label class="form-label">Consumables</label><input name="detail_consumables" class="form-control"/></div></div>}
@if(Model.Station=="Curing"){<div class="row g-2 mt-2"><div class="col-6"><label class="form-label">Cure cycle</label><input name="detail_cure_cycle" class="form-control"/></div><div class="col-6"><label class="form-label">Temperature °C</label><input name="detail_temperature_c" type="number" step="0.1" class="form-control"/></div><div class="col-6"><label class="form-label">Pressure</label><input name="detail_pressure" class="form-control"/></div><div class="col-6"><label class="form-label">Mould</label><input name="detail_mould" class="form-control"/></div><div class="col-6"><label class="form-label">Position</label><input name="detail_position" class="form-control"/></div><div class="col-6"><label class="form-label">Batch / cycle number</label><input name="detail_batch_cycle" class="form-control"/></div></div>}
@if(Model.Station=="Final Inspection"){<div class="row g-2 mt-2"><div class="col-6"><label class="form-label">Corrective action</label><input name="detail_corrective_action" class="form-control"/></div><div class="col-6"><label class="form-label">Rework required?</label><select name="detail_rework_required" class="form-select"><option>No</option><option>Yes</option></select></div></div>}
<label class="form-label mt-3">Notes / abnormalities</label><textarea name="notes" class="form-control mb-3" rows="3"></textarea><button class="btn btn-success btn-lg w-100">✓ COMPLETE & SAVE EVENT</button></form>
}
</div></section></div>
}
else if(!string.IsNullOrWhiteSpace(Model.TyreCode)){<div class="alert alert-danger">No production job could be loaded.</div>}
